# Variables de entorno de AlphaDev Studios
#
# Copia este archivo como `.env.local` y rellena los valores.
# `.env.local` está ignorado por git: NUNCA se sube.

# ─── Contacto (público) ──────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=hola@alphadev.studio
NEXT_PUBLIC_CONTACT_PHONE=+1 (407) 686-7561

# ─── Supabase — Academia, Fase 2 ─────────────────────────────────────────────
# Dónde: supabase.com → tu proyecto → Project Settings → API
#
# La URL y la clave pública van con prefijo NEXT_PUBLIC_ porque el navegador
# las necesita, y está bien: la clave pública solo puede hacer lo que permitan
# las políticas de Row Level Security de la base.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave de servicio SALTA todas las políticas de seguridad (RLS). Hace
# falta desde que existe la tienda de guías: quien compra no tiene sesión, y
# registrar su compra o firmar su descarga necesita ese privilegio. El único
# archivo que puede importarla es lib/ventas.ts — lo exige eslint.config.mjs.
# Jamás debe llevar el prefijo NEXT_PUBLIC_ ni aparecer en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── PayPal — tienda de guías ─────────────────────────────────────────────────
# Dónde: developer.paypal.com → tu cuenta Business → Apps & Credentials.
# PAYPAL_API_BASE en sandbox mientras se prueba; se cambia a la de producción
# cuando esté listo para cobrar de verdad.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# El id del webhook (Apps & Credentials → tu app → Webhooks → Add Webhook,
# apuntando a https://www.alphadev.studio/api/pagos/paypal, eventos
# CHECKOUT.ORDER.APPROVED y PAYMENT.CAPTURE.COMPLETED).
PAYPAL_WEBHOOK_ID=

# ─── Email transaccional — envío del enlace de descarga ──────────────────────
# Dónde: resend.com → API Keys. El dominio alphadev.studio debe estar
# verificado en Resend (los registros DNS van en Vercel) antes de que el
# remitente guias@alphadev.studio pueda enviar.
RESEND_API_KEY=

# ─── Analítica (opcional) ────────────────────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=
